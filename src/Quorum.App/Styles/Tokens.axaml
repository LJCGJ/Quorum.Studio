<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Tokens visuais do Quorum: fonte unica de verdade para cor, tipo e espaco,
    para as telas nao inventarem valores proprios. Derivados da marca (escudo
    navy com ciano/esmeralda) definida junto com o logo.
  -->

  <!-- ============ PALETA ============ -->
  <!-- Escuro: o tema nativo da marca (o escudo vive sobre navy profundo) -->
  <Color x:Key="NavyDeep">#0B1220</Color>
  <Color x:Key="NavySurface">#141E33</Color>
  <Color x:Key="NavyRaised">#1B2A4A</Color>
  <Color x:Key="NavyLine">#26365C</Color>

  <!-- Claro -->
  <Color x:Key="PaperBase">#F7F9FC</Color>
  <Color x:Key="PaperSurface">#FFFFFF</Color>
  <Color x:Key="PaperLine">#DCE3ED</Color>

  <!-- Acentos: os tres do escudo. Cada um marca um provedor de IA, entao a cor
       carrega informacao em vez de so decorar. -->
  <Color x:Key="AccentCyan">#38BDF8</Color>
  <Color x:Key="AccentEmerald">#34D399</Color>
  <Color x:Key="AccentIndigo">#818CF8</Color>
  <Color x:Key="AccentAmber">#FBBF24</Color>

  <!-- Texto -->
  <Color x:Key="TextOnDark">#F1F5F9</Color>
  <Color x:Key="TextOnDarkMuted">#94A3B8</Color>
  <Color x:Key="TextOnLight">#0F172A</Color>
  <Color x:Key="TextOnLightMuted">#64748B</Color>

  <!-- ============ PINCEIS ============ -->
  <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}"/>
  <SolidColorBrush x:Key="AccentEmeraldBrush" Color="{StaticResource AccentEmerald}"/>
  <SolidColorBrush x:Key="AccentIndigoBrush" Color="{StaticResource AccentIndigo}"/>
  <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmber}"/>

  <!-- ============ TIPOGRAFIA ============ -->
  <!-- Inter vem embutida (Avalonia.Fonts.Inter): mesma renderizacao nos tres
       sistemas, sem depender das fontes instaladas no SO. -->
  <FontFamily x:Key="FontUi">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

  <x:Double x:Key="FontSizeDisplay">26</x:Double>
  <x:Double x:Key="FontSizeTitle">17</x:Double>
  <x:Double x:Key="FontSizeBody">13.5</x:Double>
  <x:Double x:Key="FontSizeCaption">11.5</x:Double>

  <!-- ============ ESPACO E FORMA ============ -->
  <Thickness x:Key="PagePadding">28,24,28,24</Thickness>
  <CornerRadius x:Key="RadiusCard">10</CornerRadius>
  <CornerRadius x:Key="RadiusControl">7</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
</ResourceDictionary>
