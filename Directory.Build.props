<Project>
  <!-- Configuracoes comuns a todos os projetos da solucao Quorum.Studio -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Company>Leonardo Gonzaga</Company>
    <Product>Quorum</Product>
    <Copyright>Copyright (c) 2026 Leonardo Gonzaga - GPL-3.0</Copyright>
  </PropertyGroup>
</Project>
